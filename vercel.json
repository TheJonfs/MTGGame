{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:web",
  "outputDirectory": "packages/ui/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!assets/|real-art/|audio/|__).*)",
      "destination": "/index.html"
    }
  ]
}
